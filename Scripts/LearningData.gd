# ════════════════════════════════════════════════════════════════
#  СОХРАНЕНИЕ / ЗАГРУЗКА
# ════════════════════════════════════════════════════════════════

func _ready() -> void:
	load_progress()

func save_progress() -> void:
	var cfg = ConfigFile.new()
	for tid in completed_topics.keys():
		cfg.set_value("progress", tid, completed_topics[tid])
	cfg.save(SAVE_PATH)

func load_progress() -> void:
	completed_topics.clear()
	var cfg = ConfigFile.new()
	if cfg.load(SAVE_PATH) != OK:
		return
	for key in cfg.get_section_keys("progress"):
		completed_topics[key] = cfg.get_value("progress", key, false)


# ════════════════════════════════════════════════════════════════
#  ЛОГИКА ПРОГРЕССА
# ════════════════════════════════════════════════════════════════

func is_topic_unlocked(index: int) -> bool:
	if index == 0:
		return true
	# Открывается, если предыдущая тема пройдена
	return is_topic_completed(index - 1)

func is_topic_completed(index: int) -> bool:
	if index < 0 or index >= topics.size():
		return false
	return completed_topics.get(topics[index]["id"], false)

func mark_topic_completed(index: int) -> void:
	if index < 0 or index >= topics.size():
		return
	completed_topics[topics[index]["id"]] = true
	save_progress()

func get_completed_count() -> int:
	var count = 0
	for i in range(topics.size()):
		if is_topic_completed(i):
			count += 1
	return count

func all_completed() -> bool:
	return get_completed_count() >= topics.size()


# ════════════════════════════════════════════════════════════════
#  РАЗБЛОКИРОВКА НАБОРОВ
#  Возвращает список разблокированных стихий и индекс
#  максимально доступного sub_pack у Огненного.
# ════════════════════════════════════════════════════════════════

func get_unlocked_elements() -> Array:
	var n = get_completed_count()
	if n == 0:
		return ["Огненный"]
	elif n == 1:
		return ["Огненный", "Воздушный", "Земляной"]
	else:
		# 2+ тем — все стихии
		return ["Огненный", "Воздушный", "Земляной", "Водный", "Светлый", "Тёмный"]

# Возвращает максимальный номер разблокированного sub_pack Огненного (1-based)
func get_unlocked_fire_pack_count() -> int:
	var n = get_completed_count()
	return min(n + 1, 5)  # Темы 0..4 открывают наборы 2..5; минимум 1

func is_custom_pack_creator_unlocked() -> bool:
	return all_completed()
